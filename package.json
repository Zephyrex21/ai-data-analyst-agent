{
  "name": "ai-data-analyst-agent",
  "private": true,
  "version": "1.0.0",
  "description": "Upload a CSV, ask questions in plain English, get a real executed-and-verified answer — SQL, Python, or a narrated insight, never a guess. Client-side DuckDB + Pyodide, 5-provider LLM failover, zero server cost.",
  "keywords": [
    "data-analysis",
    "llm",
    "duckdb",
    "pyodide",
    "react",
    "typescript",
    "ai-agent",
    "csv"
  ],
  "author": "Saurabh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zephyrex21/ai-data-analyst-agent.git"
  },
  "homepage": "https://ai-data-analyst-agent-one.vercel.app/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run --config eval.vitest.config.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@tailwindcss/vite": "^4.3.2",
    "papaparse": "^5.5.4",
    "pyodide": "^314.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}

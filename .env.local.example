# Copy this file to .env.local and fill in your real key(s).
# .env.local is gitignored (matched by the *.local pattern) — never commit real keys.

GROQ_API_KEY=your_groq_api_key_here

# Optional — only needed if you want the Gemini option in the model selector.
# Free, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

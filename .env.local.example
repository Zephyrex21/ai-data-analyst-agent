# Copy this file to .env.local and fill in your real key(s).
# .env.local is gitignored (matched by the *.local pattern) — never commit real keys.
#
# Only GROQ_API_KEY is required. Every other key below is optional — add as
# many as you want and the app automatically fails over between whichever
# ones are configured if one is rate-limited (Phase 30). More keys = more
# resilience, not more required setup.

GROQ_API_KEY=your_groq_api_key_here

# Optional — free, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — free, no card required: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional — free, no card required: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional — free trial key (~1,000 calls/month, used as a last resort):
# https://dashboard.cohere.com
COHERE_API_KEY=your_cohere_api_key_here
